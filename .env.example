# Copy to .env.local for local development, and add the same names in
# Vercel → Project → Settings → Environment Variables for the live site.

# Google Sheets (sign-ups + support messages)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the whole private_key value from the service account JSON, including
# the BEGIN/END lines. "\n" sequences are converted to real line breaks.
GOOGLE_PRIVATE_KEY=
# The long ID in the sheet URL: docs.google.com/spreadsheets/d/<THIS>/edit
GOOGLE_SHEET_ID=

# Resend: the one Art Digging address sends everything and receives replies.
RESEND_API_KEY=
# The single From and Reply-To for every email (newsletter, vote confirmations)
RESEND_FROM=Art Digging <news@hello.artdigging.com>
# Signing secret of the email.received webhook (Resend → Webhooks), starts with whsec_
RESEND_WEBHOOK_SECRET=
# Private inbox that receives forwarded mail to news@ and support-form messages.
# Never shown to visitors. (SUPPORT_EMAIL is still read as a fallback.)
SUPPORT_GMAIL=

# Used for links inside emails
SITE_URL=https://artdigging.com

# Private proposals (proposal.artdigging.com/<slug>): one code per proposal
PROPOSAL_CODES=trap-house-reimagined:YOURCODE
